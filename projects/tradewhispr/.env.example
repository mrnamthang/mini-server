# tradewhispr - Environment Variables

# Docker Compose - Use both base and dev files on Asus
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PROFILES=dev

APP_ENV=production
APP_DEBUG=false
APP_URL=https://tradewhispr.local

# Frontend API Configuration (configured in docker-compose.yml)
# VITE_API_BASE_URL is set to http://api.tradewhispr.local in docker-compose.yml

DB_CONNECTION=
DB_HOST=tradewhispr-db
DB_PORT=
DB_DATABASE=tradewhispr
DB_USERNAME=tradewhispr
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

REDIS_HOST=tradewhispr-redis
REDIS_PORT=6379

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
